{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-editor",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@r360/admin",
        "exec",
        "next",
        "dev",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "viewer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@r360/viewer",
        "exec",
        "vite",
        "--port",
        "5183"
      ],
      "port": 5183
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@r360/site",
        "dev"
      ],
      "port": 5190
    }
  ]
}
