# ── Modo mock ────────────────────────────────────────────────────────────
# En 1 el panel no toca Supabase: sirve el seed de Baleia desde memoria y
# la sesion es un owner ficticio. Es el modo por defecto para desarrollo.
NEXT_PUBLIC_R360_MOCK=1

# ── Supabase (solo con NEXT_PUBLIC_R360_MOCK=0) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service key de Supabase. SOLO de servidor (nunca NEXT_PUBLIC_). El alta de
# tenant YA NO la usa (P2b: createTenant escribe con la sesión del usuario,
# la policy `tenants_insert` de 0019 lo permite para Vrotta Admin). Hoy la
# usan: storage.ts (material subido por el cliente vía link) y
# supabase-repo.ts al listar/sumar el equipo de Vrotta en /admin/team, que
# necesita la Admin API para resolver el email de un `user_id` (auth.users no
# se puede leer con la sesión normal). Nunca exponer al navegador.
SUPABASE_SERVICE_KEY=

# ── Publicación contra apps/worker (solo con NEXT_PUBLIC_R360_MOCK=0) ────
# El panel no publica directo a R2/KV: le pega a apps/worker, que sí tiene la
# service key de Supabase. Estas dos son de SERVIDOR (nunca NEXT_PUBLIC_):
# viajan en el fetch a publish()/revertPublication(), nunca al navegador.

# URL base del Worker (sin barra final). En producción es el host fijo de la
# plataforma, p.ej. https://app.vrottaprop360.com (ver DESPLIEGUE-VPS.md
# sección 0 y apps/worker/README.md — el Worker corre como proceso Node en
# el VPS, no en Cloudflare Workers pese al nombre).
WORKER_URL=

# Mismo valor que la variable de entorno PUBLISH_SECRET del Worker (ver
# apps/worker/README.md, tabla de variables obligatorias de src/server.ts) —
# autoriza /api/publish y /api/rollback. Si no coincide, el Worker rechaza
# con 401; si falta acá, publish()/revertPublication() fallan con un mensaje
# explícito en vez de intentar el fetch.
R360_PUBLISH_SECRET=

# ── Alta de clientes (REEMPLAZADA — hallazgo B7, medida puente cerrada) ──
# R360_PLATFORM_ADMINS existió hasta acá: una lista de emails en una env var
# decidía quién podía dar de alta un tenant (/t/new, hoy borrada). Desde que
# el rol de plataforma vive en la base (migración 0019, tabla
# `platform_members`), la autorización real es esa tabla: `canCreateTenant`
# en lib/roles.ts y la policy `tenants_insert` la consultan directamente.
# El alta ahora es /admin/clients/new (sólo Vrotta Admin) y el equipo de
# Vrotta se gestiona en /admin/team — ninguna de las dos pantallas necesita
# variables de entorno. No hay nada que configurar acá.

# ── Contacto en /signup ───────────────────────────────────────────────────
# /signup ya no crea cuentas: muestra que el acceso es por invitación y
# ofrece un camino de contacto real. Ambas son opcionales, pero conviene
# cargar al menos una — si ninguna está configurada, la pantalla igual
# funciona, sólo que sin ningún link (nunca un link roto).

# Email de contacto: arma un mailto: con asunto precargado.
R360_CONTACT_EMAIL=

# Teléfono de WhatsApp en formato internacional (con o sin '+', espacios o
# guiones — se limpia solo): arma un link https://wa.me/<numero>.
R360_CONTACT_WHATSAPP=
