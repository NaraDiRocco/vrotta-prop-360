# ── Modo mock ────────────────────────────────────────────────────────────
# En 1 el panel no toca Supabase: sirve el seed de Baleia desde memoria y
# la sesion es un owner ficticio. Es el modo por defecto para desarrollo.
NEXT_PUBLIC_R360_MOCK=1

# ── Supabase (solo con NEXT_PUBLIC_R360_MOCK=0) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service key de Supabase. SOLO de servidor (nunca NEXT_PUBLIC_): hoy la usa
# el alta de tenant nuevo (lib/onboarding/service-client.ts, rompe la
# circularidad de RLS del primer alta) y storage.ts para guardar material
# subido por el cliente vía link. Nunca exponer al navegador.
SUPABASE_SERVICE_KEY=

# ── Publicación contra apps/worker (solo con NEXT_PUBLIC_R360_MOCK=0) ────
# El panel no publica directo a R2/KV: le pega a apps/worker, que sí tiene la
# service key de Supabase. Estas dos son de SERVIDOR (nunca NEXT_PUBLIC_):
# viajan en el fetch a publish()/revertPublication(), nunca al navegador.

# URL base del Worker desplegado (sin barra final), p.ej. https://r360-worker.<subdominio>.workers.dev
WORKER_URL=

# Mismo valor que el secret `PUBLISH_SECRET` del Worker (wrangler secret put
# PUBLISH_SECRET) — autoriza /api/publish y /api/rollback. Si no coincide,
# el Worker rechaza con 401; si falta acá, publish()/revertPublication()
# fallan con un mensaje explícito en vez de intentar el fetch.
R360_PUBLISH_SECRET=

# ── Alta de clientes (hallazgo B7 — MEDIDA PUENTE) ───────────────────────
# Vrotta Prop 360 se vende uno a uno: el registro NO es abierto. Esta lista
# controla quién puede crear un tenant nuevo desde /t/new y su endpoint
# (POST /api/t/[tenant]). De SERVIDOR, nunca NEXT_PUBLIC_: si el navegador
# la pudiera leer, cualquiera vería quién tiene permiso de dar de alta
# clientes. Vacía o ausente = alta de tenants CERRADA para todos (default
# cerrado, no abierto). Esto es transitorio: cuando exista un rol de
# plataforma en la base (en diseño en paralelo), esta variable se reemplaza
# por esa tabla.
# Emails separados por coma, ej: dueña@vrotta.com,otra@vrotta.com
R360_PLATFORM_ADMINS=

# ── Contacto en /signup ───────────────────────────────────────────────────
# /signup ya no crea cuentas: muestra que el acceso es por invitación y
# ofrece un camino de contacto real. Ambas son opcionales, pero conviene
# cargar al menos una — si ninguna está configurada, la pantalla igual
# funciona, sólo que sin ningún link (nunca un link roto).

# Email de contacto: arma un mailto: con asunto precargado.
R360_CONTACT_EMAIL=

# Teléfono de WhatsApp en formato internacional (con o sin '+', espacios o
# guiones — se limpia solo): arma un link https://wa.me/<numero>.
R360_CONTACT_WHATSAPP=
